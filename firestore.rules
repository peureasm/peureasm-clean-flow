
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HOSPITAL LAUNDRY MANAGEMENT SYSTEM - SECURITY RULES
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    match /roles_admin/{adminUid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /laundryItems/{laundryItemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /discrepancyReasons/{reasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /collectionRequests/{requestId} {
      // 모든 인증된 사용자가 읽기 가능하도록 설정 (프로토타입 단계)
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /settlements/{settlementId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
