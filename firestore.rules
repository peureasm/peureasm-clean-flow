
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * Clean-flow - Advanced Security Rules
     */
    
    // 도우미 함수: 로그인 여부 확인
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. 비즈니스 데이터 (수거 요청 및 상세 품목)
    // 재귀적 와일드카드를 사용하여 목록 조회(list)와 하위 문서(items) 접근을 모두 허용
    match /collectionRequests/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 2. 마스터 데이터 (사용자, 병원, 품목)
    // 앱 초기 구동 및 프로필 생성을 위해 읽기는 전체 허용
    // 쓰기는 로그인된 사용자만 가능
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 3. 기타 모든 경로에 대한 기본 규칙
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
