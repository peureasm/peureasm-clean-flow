rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HOSPITAL LAUNDRY MANAGEMENT SYSTEM - SECURITY RULES
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper to fetch the current user's record safely
    function currentUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    // Checks if the user belongs to a specific hospital
    function isHospitalMember(hospitalId) {
      let user = currentUserData();
      return isSignedIn() && (isAdmin() || (user != null && user.hospitalId == hospitalId));
    }

    // --- COLLECTION RULES ---

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow get: if isHospitalMember(hospitalId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))) || isAdmin();
      allow delete: if isAdmin();
    }

    match /laundryItems/{laundryItemId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /discrepancyReasons/{reasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /collectionRequests/{requestId} {
      // Allow get if admin or a member of the hospital that owns the request
      allow get: if isSignedIn() && (isAdmin() || (resource != null && isHospitalMember(resource.data.hospitalId)));
      // Simplified list for prototype: allow any signed in user to list, filtered by query in client
      allow list: if isSignedIn(); 
      allow create: if isSignedIn() && (isAdmin() || isHospitalMember(request.resource.data.hospitalId));
      allow update: if isSignedIn() && (isAdmin() || (resource != null && isHospitalMember(resource.data.hospitalId)));
      allow delete: if isAdmin();

      match /{subCollection=**}/{docId} {
        allow get: if isSignedIn() && (isAdmin() || (resource != null && isHospitalMember(resource.data.hospitalId)));
        allow list: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    match /settlements/{settlementId} {
      allow get: if isAdmin() || (resource != null && isHospitalMember(resource.data.hospitalId));
      allow list: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /itemDetails/{detailId} {
        allow get: if isAdmin() || (resource != null && isHospitalMember(resource.data.hospitalId));
        allow list: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }
    }
  }
}