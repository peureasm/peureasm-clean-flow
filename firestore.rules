
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영을 위해 인증된 사용자에게 관대한 규칙을 적용합니다.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isSignedIn() && (getUserData().role == role || request.auth.token.role == role);
    }
    
    function isAdmin() {
      return hasRole('ADMIN');
    }

    // 사용자 프로필
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // 병원 마스터
    match /hospitals/{hospitalId} {
      allow read, write: if isSignedIn();
    }

    // 세탁 품목 마스터
    match /laundryItems/{itemId} {
      allow read, write: if isSignedIn();
    }

    // 세탁 수거 요청
    match /collectionRequests/{requestId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();

      match /items/{itemId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
