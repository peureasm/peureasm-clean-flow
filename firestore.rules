
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영을 위해 인증된 사용자에게 광범위한 데이터 접근 권한을 부여합니다.
     */
    
    // 1. 마스터 데이터 (사용자, 병원, 품목)
    // 앱 초기화 및 공용 조회를 위해 읽기는 전체 허용, 쓰기는 인증 필요
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 2. 비즈니스 데이터 (세탁 수거 요청 및 공정 데이터)
    // {document=**} 와일드카드를 사용하여 컬렉션 목록 조회 및 모든 하위 경로(items 등) 접근 허용
    match /collectionRequests/{document=**} {
      allow read, write: if request.auth != null;
    }

    // 3. 기타 모든 시스템 경로
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
