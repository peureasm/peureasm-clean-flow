
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영과 앱 초기화 시의 Auth 토큰 전파 지연을 고려하여 
     * 마스터 데이터 및 사용자 프로필의 읽기 권한을 개방합니다.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    // 사용자 프로필
    match /users/{userId} {
      // 초기 로딩 시의 권한 에러를 방지하기 위해 읽기 허용
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 병원 마스터
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 세탁 품목 마스터
    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 세탁 수거 요청 및 하위 모든 데이터 (items 포함)
    // 인증된 사용자라면 전체 목록 조회 및 상세 조회가 가능하도록 설정
    match /collectionRequests/{requestId} {
      allow read, write: if isSignedIn();
      
      // 하위 모든 경로(예: items 서브컬렉션)에 대해 재귀적으로 권한 허용
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
