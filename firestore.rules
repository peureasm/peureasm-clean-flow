
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영을 위해 인증된 사용자에게 데이터 접근 권한을 부여합니다.
     */
    
    // 마스터 데이터 (병원, 품목, 사용자 프로필)
    // 앱 초기화 및 공용 조회를 위해 읽기는 모두에게 허용합니다.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 세탁 수거 요청 및 모든 하위 경로 (items 등)
    // 명시적으로 requestId 매칭을 통해 list와 get 권한을 보장합니다.
    match /collectionRequests/{requestId} {
      allow read, write: if request.auth != null;
      
      // 하위 서브컬렉션 (예: items)에 대한 재귀적 권한 부여
      match /{allPaths=**} {
        allow read, write: if request.auth != null;
      }
    }

    // 기타 모든 데이터에 대한 기본 보안 (인증된 사용자 전용)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
