
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영과 역할 전환 테스트를 위해 
     * 인증된 사용자에게 모든 비즈니스 데이터의 읽기/쓰기 권한을 허용합니다.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    // 마스터 데이터 및 사용자 프로필
    // 초기 로딩 지연(Race Condition)으로 인한 권한 에러를 방지하기 위해 읽기 권한을 개방합니다.
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 세탁 수거 요청 및 모든 하위 서브컬렉션
    // 인증된 사용자라면 전체 목록 조회(list) 및 상세 조회가 가능하도록 설정
    match /collectionRequests/{allPaths=**} {
      allow read, write: if isSignedIn();
    }

    // 기타 모든 경로에 대한 기본 보안 설정
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
