
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Prototype Security Rules
     * 프로토타입 단계에서는 인증된 모든 사용자가 모든 데이터를 읽고 쓸 수 있도록 허용합니다.
     */
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
