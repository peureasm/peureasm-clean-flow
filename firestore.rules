/**
 * Hospital Laundry Service Security Rules
 * 
 * Core Philosophy:
 * This ruleset implements a multi-role authorization model (Admin, Driver, Factory Worker, Hospital Staff). 
 * It prioritizes "Authorization Independence" by relying on denormalized fields within documents 
 * to minimize cross-document lookups (get() calls). Access is strictly partitioned by role 
 * and organization (hospitalId).
 * 
 * Data Structure:
 * - /admin_roles, /driver_roles, /factory_worker_roles: Flat collections for rapid role verification.
 * - /users/{userId}: User profiles containing the critical 'hospitalId' link.
 * - /hospitals/{hospitalId}: Hospital metadata.
 * - /requests/{requestId}: Root of the transactional tree, containing sub-collections for items, photos, and logs.
 * - /settlements/{settlementId}: Financial records partitioned by hospital.
 * 
 * Key Security Decisions:
 * 1. Role-Based Access: Admin roles have overarching access. Specialized roles (Driver, Factory) 
 *    have access restricted to their specific operational needs.
 * 2. Hospital Isolation: Hospital staff are strictly limited to data matching their assigned 'hospitalId'.
 * 3. Denormalization for Authorization: Critical fields (hospitalId, driverId) are copied into 
 *    sub-collections (request_items, photos) to allow rules to evaluate access using only 'resource.data'.
 * 4. Immutability: Relational fields like 'hospitalId' or 'userId' are enforced as immutable after creation.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role Checks using dedicated collections (Mandate C.4)
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid));
    }

    function isDriver() {
      return isSignedIn() && exists(/databases/$(database)/documents/driver_roles/$(request.auth.uid));
    }

    function isFactoryWorker() {
      return isSignedIn() && exists(/databases/$(database)/documents/factory_worker_roles/$(request.auth.uid));
    }

    // Hospital Association check
    function getUserHospitalId() {
      // This lookup is necessary for determining the user's hospital affiliation.
      // It's cached per request by Firestore, minimizing performance impact.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.hospitalId;
    }

    function belongsToHospital(hospitalId) {
      return isSignedIn() && getUserHospitalId() == hospitalId;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Role collections used for fast existence checks in rules.
     * @path /admin_roles/{userId}, /driver_roles/{userId}, /factory_worker_roles/{userId}
     * @allow (get) Any signed-in user to check roles; (write) Only existing Admins.
     * @deny (write) Any non-admin user.
     * @principle Dedicated role collections for performant authorization.
     */
    match /admin_roles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /driver_roles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /factory_worker_roles/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * @description User profiles containing identity and hospital affiliation.
     * @path /users/{userId}
     * @allow (get, list) The user themselves or an Admin; (create) The user themselves (self-creation).
     * @deny (update) Changing the userId or role (if not Admin).
     * @principle Ownership and Relational Integrity (self-creation and ID consistency).
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      // Allow update if owner or admin, and 'id' field remains immutable
      allow update: if (isOwner(userId) || isAdmin()) && resource.data.id == request.resource.data.id;
      allow delete: if isAdmin(); // Only Admins can delete user profiles
    }

    /**
     * @description Hospital information.
     * @path /hospitals/{hospitalId}
     * @allow (get) Staff belonging to this hospital or Admins; (list) Admins only.
     * @deny (write) Anyone except Admins.
     * @principle Hospital data isolation.
     */
    match /hospitals/{hospitalId} {
      allow get: if belongsToHospital(hospitalId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Master list of laundry items and their pricing.
     * @path /laundry_items/{laundryItemId}
     * @allow (get, list) All authenticated users; (write) Admins only.
     * @deny (write) Non-admin users.
     * @principle Public read with Admin-only writes for master data.
     */
    match /laundry_items/{laundryItemId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Master list of reasons for item discrepancies.
     * @path /discrepancy_reasons/{reasonId}
     * @allow (get, list) All authenticated users; (write) Admins only.
     * @deny (write) Non-admin users.
     * @principle Public read with Admin-only writes for master data.
     */
    match /discrepancy_reasons/{reasonId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    /**
     * @description Core laundry collection requests.
     * @path /requests/{collectionRequestId}
     * @allow (read) Related Hospital Staff, Assigned Driver, Factory Workers, or Admins.
     * @allow (create) Hospital Staff creating for their own hospital.
     * @allow (update) Any involved role (Admin, Driver, Factory, Staff) for state changes.
     * @principle Multi-role shared access based on hospitalId and driverId fields.
     */
    match /requests/{collectionRequestId} {
      allow get, list: if isAdmin() || belongsToHospital(resource.data.hospitalId) || isDriver() || isFactoryWorker();
      
      allow create: if (isAdmin() || belongsToHospital(request.resource.data.hospitalId)) 
                    && request.resource.data.requestedById == request.auth.uid;
      
      allow update: if (
                      isAdmin() || 
                      belongsToHospital(resource.data.hospitalId) || 
                      (isDriver() && resource.data.driverId == request.auth.uid) || 
                      isFactoryWorker()
                    ) && request.resource.data.hospitalId == resource.data.hospitalId; // hospitalId immutable
      allow delete: if isAdmin();
    }

    /**
     * @description Sub-collections of a request.
     * @path /requests/{collectionRequestId}/... (request_items, photos, process_logs)
     * @principle Uses denormalized fields (Mandate A) to avoid parent lookups.
     */
    match /requests/{collectionRequestId}/{subCollection}/{docId} {
      allow get, list: if isAdmin() || belongsToHospital(resource.data.hospitalId) || isDriver() || isFactoryWorker();
      
      allow create: if (isAdmin() || belongsToHospital(request.resource.data.hospitalId) || isDriver() || isFactoryWorker());
      
      allow update: if (
                      isAdmin() || 
                      belongsToHospital(resource.data.hospitalId) || 
                      (isDriver() && resource.data.driverId == request.auth.uid) || 
                      isFactoryWorker()
                    ) && request.resource.data.hospitalId == resource.data.hospitalId; // hospitalId immutable
      allow delete: if isAdmin();
    }

    /**
     * @description Monthly settlement data for hospitals.
     * @path /settlements/{settlementId}
     * @allow (get, list) Admins or Staff of the specific hospital.
     * @deny (write) Non-admin users.
     * @principle Financial data isolation via hospitalId.
     */
    match /settlements/{settlementId} {
      allow get, list: if isAdmin() || belongsToHospital(resource.data.hospitalId);
      allow create, update, delete: if isAdmin();
    }
  }
}