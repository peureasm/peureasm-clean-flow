
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HOSPITAL LAUNDRY MANAGEMENT SYSTEM - SECURITY RULES
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    // Checks if the user belongs to a specific hospital
    function isHospitalMember(hospitalId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      let user = exists(path) ? get(path).data : null;
      return isSignedIn() && (isAdmin() || (user != null && user.hospitalId == hospitalId));
    }

    // --- COLLECTION RULES ---

    match /roles_admin/{adminUid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow get: if isSignedIn() && isHospitalMember(hospitalId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /laundryItems/{laundryItemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /discrepancyReasons/{reasonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /collectionRequests/{requestId} {
      // Allow read for prototype to avoid permission denied on collection list
      allow read: if isSignedIn();
      
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();

      match /{subCollection=**}/{docId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    match /settlements/{settlementId} {
      allow get: if isSignedIn() && (isAdmin() || isHospitalMember(resource.data.hospitalId));
      allow list: if isSignedIn();
      allow write: if isAdmin();

      match /itemDetails/{detailId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }
  }
}
