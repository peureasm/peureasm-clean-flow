
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입의 원활한 테스트를 위해 인증된 사용자에게 비즈니스 데이터 접근 권한을 명시적으로 부여합니다.
     */
    
    // 1. 비즈니스 데이터 (수거 요청 및 상세 품목)
    // 컬렉션 전체 목록(list)과 개별 문서(get) 접근을 모두 허용
    match /collectionRequests/{requestId} {
      allow read, write: if request.auth != null;
      
      // 하위 items 서브컬렉션에 대한 재귀적 권한 허용
      match /items/{itemId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // collectionRequests 컬렉션 자체에 대한 list 권한 허용
    match /collectionRequests {
      allow list: if request.auth != null;
    }

    // 2. 마스터 데이터 (사용자, 병원, 품목)
    // 앱 초기 구동 및 권한 확인을 위해 읽기는 전체 허용 (비로그인 포함)
    // 쓰기는 로그인된 사용자만 가능
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. 기타 모든 경로에 대한 기본 규칙
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
