
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    /**
     * MediLaundry Flow - Security Rules
     * 프로토타입 단계의 원활한 운영과 역할 전환 테스트를 위해 
     * 인증된 사용자에게 모든 비즈니스 데이터의 읽기/쓰기 권한을 허용합니다.
     */
    
    function isSignedIn() {
      return request.auth != null;
    }

    // 마스터 데이터 (병원, 품목, 사용자 프로필)
    // 읽기는 모두에게 허용하여 앱 초기화 시 권한 오류를 방지합니다.
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /laundryItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // 세탁 수거 요청 및 모든 하위 경로 (items 등)
    // {document=**}를 사용하여 컬렉션 목록 조회(list) 및 문서 접근(get) 권한을 확실히 보장합니다.
    match /collectionRequests/{document=**} {
      allow read, write: if isSignedIn();
    }

    // 기타 모든 데이터에 대한 기본 보안
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
