
{
  "entities": {
    "Hospital": {
      "title": "Hospital",
      "type": "object",
      "description": "세탁 서비스를 이용하는 병원 정보",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "contactPersonName": { "type": "string" },
        "contactPersonPhone": { "type": "string" },
        "registrationDate": { "type": "string", "format": "date-time" },
        "assignedDriverId": { "type": "string", "description": "배정된 기사 UID" },
        "assignedDriverName": { "type": "string", "description": "배정된 기사 성함" }
      },
      "required": ["id", "name", "address"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "시스템 사용자 정보 및 권한",
      "properties": {
        "id": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["HOSPITAL", "DRIVER", "FACTORY", "ADMIN"] },
        "hospitalId": { "type": "string", "description": "병원 담당자인 경우 소속 병원 ID" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "role", "isActive"]
    },
    "CollectionRequest": {
      "title": "CollectionRequest",
      "type": "object",
      "description": "세탁물 수거 요청 기본 정보",
      "properties": {
        "id": { "type": "string" },
        "hospitalId": { "type": "string" },
        "hospitalName": { "type": "string" },
        "requestorId": { "type": "string" },
        "requestDate": { "type": "string", "format": "date" },
        "currentStatus": { "type": "string", "enum": ["제출", "수거완료", "공장입고", "세탁중", "건조중", "포장완료", "출고", "납품완료", "병원확인완료", "종결"] },
        "specialNotes": { "type": "string" },
        "hospitalFeedback": { "type": "string", "description": "최종 확인 시 병원 담당자의 피드백" },
        "isContaminated": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "finalConfirmedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hospitalId", "currentStatus", "createdAt"]
    },
    "CollectionRequestItem": {
      "title": "CollectionRequestItem",
      "type": "object",
      "description": "수거 요청별 세부 품목 및 단계별 수량",
      "properties": {
        "id": { "type": "string" },
        "laundryItemId": { "type": "string" },
        "itemName": { "type": "string" },
        "requestedQuantity": { "type": "number", "description": "병원 입력량" },
        "verifiedQuantity": { "type": "number", "description": "기사 확인량" },
        "inboundQuantity": { "type": "number", "description": "공장 입고량" },
        "deliveredQuantity": { "type": "number", "description": "최종 납품량" }
      },
      "required": ["id", "laundryItemId", "requestedQuantity"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/hospitals/{hospitalId}",
        "definition": { "entityName": "Hospital", "schema": { "$ref": "#/backend/entities/Hospital" }, "description": "병원 마스터 정보" }
      },
      {
        "path": "/users/{userId}",
        "definition": { "entityName": "User", "schema": { "$ref": "#/backend/entities/User" }, "description": "사용자 프로필 및 권한" }
      },
      {
        "path": "/collectionRequests/{collectionRequestId}",
        "definition": { "entityName": "CollectionRequest", "schema": { "$ref": "#/backend/entities/CollectionRequest" }, "description": "수거 요청 헤더" }
      },
      {
        "path": "/collectionRequests/{collectionRequestId}/items/{itemId}",
        "definition": { "entityName": "CollectionRequestItem", "schema": { "$ref": "#/backend/entities/CollectionRequestItem" }, "description": "수거 요청 상세 품목" }
      }
    ]
  }
}
