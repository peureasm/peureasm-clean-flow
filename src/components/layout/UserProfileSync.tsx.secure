'use client';

import { Suspense, useEffect, useRef } from 'react';
import { usePathname, useRouter, useSearchParams } from 'next/navigation';
import {
  useFirestore,
  useUser,
  setDocumentNonBlocking,
  updateDocumentNonBlocking,
} from '@/firebase';
import { doc, serverTimestamp } from 'firebase/firestore';
import { useToast } from '@/hooks/use-toast';
import type { UserRole } from '@/app/lib/types';
import { isAdminEmail } from '@/lib/admin-emails';
import { postAuthenticatedJson } from '@/lib/authenticated-api';

function UserProfileSyncInner() {
  const pathname = usePathname();
  const router = useRouter();
  const searchParams = useSearchParams();
  const firestore = useFirestore();
  const { user, userData, isUserLoading } = useUser();
  const { toast } = useToast();
  const acceptedInviteRef = useRef<string | null>(null);

  useEffect(() => {
    if (!user || !firestore || isUserLoading) return;

    const userRef = doc(firestore, 'users', user.uid);
    const inviteToken = searchParams.get('inviteToken');
    const requestedRoleParam = (searchParams.get('requestedRole') || '').toUpperCase();
    const requestedRole: UserRole | null =
      requestedRoleParam === 'HOSPITAL' ||
      requestedRoleParam === 'DRIVER' ||
      requestedRoleParam === 'FACTORY' ||
      requestedRoleParam === 'ADMIN'
        ? (requestedRoleParam as UserRole)
        : null;

    if (inviteToken && !userData?.role && acceptedInviteRef.current !== inviteToken) {
      acceptedInviteRef.current = inviteToken;

      void (async () => {
        try {
          await postAuthenticatedJson(user.auth, '/api/invitations/accept', {
            inviteToken,
          });

          if (pathname !== '/pending') {
            router.replace('/pending');
          }
        } catch (error) {
          acceptedInviteRef.current = null;
          toast({
            variant: 'destructive',
            title: 'Invite verification failed',
            description:
              error instanceof Error ? error.message : 'Unable to verify the invite link.',
          });
        }
      })();

      return;
    }

    if (!userData) {
      const defaultRole: UserRole | null = isAdminEmail(user.email) ? 'ADMIN' : null;

      setDocumentNonBlocking(
        userRef,
        {
          id: user.uid,
          username: user.email || `user_${user.uid.slice(0, 8)}`,
          name: user.displayName || user.email || `user_${user.uid.slice(0, 8)}`,
          role: defaultRole,
          roleRequested: defaultRole ?? requestedRole ?? 'HOSPITAL',
          hospitalId: null,
          isActive: true,
          updatedAt: serverTimestamp(),
          createdAt: serverTimestamp(),
        },
        { merge: true }
      );
      return;
    }

    if (!userData.role && requestedRole && userData.roleRequested !== requestedRole) {
      updateDocumentNonBlocking(userRef, {
        roleRequested: requestedRole,
        updatedAt: serverTimestamp(),
      });
    }
  }, [user, userData, isUserLoading, firestore, searchParams, toast, pathname, router]);

  useEffect(() => {
    if (!user?.email || !firestore || !userData || isUserLoading) return;
    if (!isAdminEmail(user.email)) return;
    if (userData.role === 'ADMIN') return;

    updateDocumentNonBlocking(doc(firestore, 'users', user.uid), {
      role: 'ADMIN',
      roleRequested: 'ADMIN',
      updatedAt: serverTimestamp(),
    });
  }, [user, userData, firestore, isUserLoading]);

  return null;
}

export default function UserProfileSync() {
  return (
    <Suspense fallback={null}>
      <UserProfileSyncInner />
    </Suspense>
  );
}
