rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'peureasm@gmail.com';
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveProfile() {
      return hasUserProfile() && currentUserData().isActive == true;
    }

    function isAdmin() {
      return isAdminEmail() || (isActiveProfile() && currentUserData().role == 'ADMIN');
    }

    function isHospitalUser() {
      return isActiveProfile() && currentUserData().role == 'HOSPITAL';
    }

    function isDriverUser() {
      return isActiveProfile() && currentUserData().role == 'DRIVER';
    }

    function isFactoryUser() {
      return isActiveProfile() && currentUserData().role == 'FACTORY';
    }

    function isOwnUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHospitalMemberOf(hospitalId) {
      return isHospitalUser() && currentUserData().hospitalId == hospitalId;
    }

    function isAssignedDriverForHospital(hospitalId) {
      return isDriverUser()
        && exists(/databases/$(database)/documents/hospitals/$(hospitalId))
        && get(/databases/$(database)/documents/hospitals/$(hospitalId)).data.assignedDriverId == request.auth.uid;
    }

    function canReadHospital(hospitalId) {
      return isAdmin()
        || isFactoryUser()
        || isHospitalMemberOf(hospitalId)
        || isAssignedDriverForHospital(hospitalId);
    }

    function canReadRequest(hospitalId) {
      return isAdmin()
        || isFactoryUser()
        || isHospitalMemberOf(hospitalId)
        || isAssignedDriverForHospital(hospitalId);
    }

    function isValidSelfUserCreate(userId) {
      return request.resource.data.keys().hasOnly([
          'id',
          'username',
          'name',
          'role',
          'roleRequested',
          'hospitalId',
          'isActive',
          'updatedAt',
          'createdAt'
        ])
        && request.resource.data.id == userId
        && request.resource.data.isActive == true
        && (
          (isAdminEmail() && request.resource.data.role == 'ADMIN')
          || (!isAdminEmail() && request.resource.data.role == null)
        );
    }

    function isValidSelfUserUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'username',
          'roleRequested',
          'hospitalId',
          'updatedAt',
          'role'
        ])
        && (
          (isAdminEmail() && request.resource.data.role == 'ADMIN')
          || (!isAdminEmail() && request.resource.data.role == resource.data.role)
        )
        && (
          resource.data.role == null
          || request.resource.data.hospitalId == resource.data.hospitalId
        );
    }

    function isSafeHospitalSelfUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'name',
          'address',
          'contactPersonName',
          'contactPersonPhone',
          'updatedAt'
        ])
        && request.resource.data.assignedDriverId == resource.data.assignedDriverId
        && request.resource.data.assignedDriverName == resource.data.assignedDriverName
        && request.resource.data.assignedItemIds == resource.data.assignedItemIds;
    }

    function isValidHospitalRequestCreate() {
      return isHospitalUser()
        && currentUserData().hospitalId == request.resource.data.hospitalId
        && request.resource.data.requestorId == request.auth.uid
        && request.resource.data.currentStatus == '제출';
    }

    function isValidHospitalRequestUpdate() {
      return isHospitalMemberOf(resource.data.hospitalId)
        && resource.data.currentStatus == '납품완료'
        && request.resource.data.currentStatus == '병원확인완료'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'currentStatus',
          'hospitalFeedback',
          'finalConfirmedAt'
        ]);
    }

    function isValidDriverRequestUpdate() {
      return isAssignedDriverForHospital(resource.data.hospitalId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'currentStatus',
          'discrepancyReason',
          'updatedAt'
        ])
        && (
          (resource.data.currentStatus == '제출' && request.resource.data.currentStatus == '수거완료')
          || (resource.data.currentStatus == '출고' && request.resource.data.currentStatus == '납품완료')
        );
    }

    function isValidFactoryRequestUpdate() {
      return isFactoryUser()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'currentStatus',
          'updatedAt',
          'inboundAt',
          'outboundAt'
        ])
        && (
          (resource.data.currentStatus == '수거완료' && request.resource.data.currentStatus == '공장입고')
          || (resource.data.currentStatus == '공장입고' && request.resource.data.currentStatus == '세탁중')
          || (resource.data.currentStatus == '세탁중' && request.resource.data.currentStatus == '건조중')
          || (resource.data.currentStatus == '건조중' && request.resource.data.currentStatus == '포장완료')
          || (resource.data.currentStatus == '포장완료' && request.resource.data.currentStatus == '출고')
        );
    }

    function isValidHospitalRequestItemCreate(requestId) {
      return isHospitalUser()
        && currentUserData().hospitalId == request.resource.data.hospitalId
        && request.resource.data.collectionRequestId == requestId;
    }

    function isValidDriverItemUpdate() {
      return isAssignedDriverForHospital(resource.data.hospitalId)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'verifiedQuantity'
        ]);
    }

    function isValidFactoryItemUpdate() {
      return isFactoryUser()
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'inboundQuantity',
          'outboundQuantity',
          'deliveredQuantity'
        ]);
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create: if isAdmin() || (isOwnUser(userId) && isValidSelfUserCreate(userId));
      allow update: if isAdmin() || (isOwnUser(userId) && isValidSelfUserUpdate());
      allow delete: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if canReadHospital(hospitalId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isHospitalMemberOf(hospitalId) && isSafeHospitalSelfUpdate());
    }

    match /laundryItems/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /collectionRequests/{requestId} {
      allow read: if canReadRequest(resource.data.hospitalId);
      allow create: if isAdmin() || isValidHospitalRequestCreate();
      allow update: if isAdmin()
        || isValidHospitalRequestUpdate()
        || isValidDriverRequestUpdate()
        || isValidFactoryRequestUpdate();
      allow delete: if isAdmin();
    }

    match /collectionRequests/{requestId}/items/{itemId} {
      allow read: if canReadRequest(resource.data.hospitalId);
      allow create: if isAdmin() || isValidHospitalRequestItemCreate(requestId);
      allow update: if isAdmin() || isValidDriverItemUpdate() || isValidFactoryItemUpdate();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
